{
  "name": "astir",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A daily to-do list that resets every day, on the web and Windows",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "npm run cf:types && tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply astir-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply astir-db --remote"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "esbuild": false,
    "workerd": false
  }
}
