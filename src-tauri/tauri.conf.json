{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Astir",
  "version": "../package.json",
  "identifier": "com.stonedragonmedia.astir",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Astir",
        "width": 440,
        "height": 1000,
        "minWidth": 360,
        "minHeight": 480,
        "visible": false
      },
      {
        "label": "quick-add",
        "title": "Add to today",
        "width": 520,
        "height": 108,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://astir.stonedragonmedia.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'none'; object-src 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "astir"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0MjI5NjBBNDcxMDdDNTUKUldSVmZCQkhDcFlpUkFSQ3ZkTHFCZzZ3eCtGdnNiTjZFSzZuMUxtTHRBVEc5SUw5REtadTl5TjYK",
      "endpoints": [
        "https://github.com/jmusick/astir/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Stone Dragon Media",
    "shortDescription": "A daily to-do list that resets every day",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
