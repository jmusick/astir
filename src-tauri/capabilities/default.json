{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the shared UI may ask of the native shell. Keep it to native features (D12).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://astir.stonedragonmedia.com/*" },
        { "url": "http://localhost:5173/*" }
      ]
    }
  ]
}
